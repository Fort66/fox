* Списки: индексация и присваивание элементу (шаг 4b, нумерация с 1)

local nums = [10, 20, 30]
local strs = ["a", "b", "c"]

print nums[1]
print nums[3]
print strs[2]

local i = 2
print nums[i]
print nums[i + 1]

nums[1] = 99
print nums[1]
strs[3] = "z"
print strs[3]

print nums[count(nums)]

if nums[1] == 99 and strs[3] == "z"
    print "indexing ok"
endif